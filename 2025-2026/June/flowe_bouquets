class Solution {
    public int minDays(int[] bloomDay, int m, int k) {

        if ((long)m * k > bloomDay.length) return -1;

        int low = 1;
        int high = 0;

        for (int i = 0; i < bloomDay.length; i++) {
            high = Math.max(high, bloomDay[i]);
        }

        while (low <= high) {

            int mid = (low + high) / 2;
            int count = 0;
            int bouquets = 0;

            for (int i = 0; i < bloomDay.length; i++) {

                if (bloomDay[i] <= mid) {
                    count++;
                }

                else {
                    bouquets += count / k;
                    count = 0;
                }
            }

            bouquets += count / k;

            if (bouquets >= m) {
                high = mid - 1;
            }

            else {
                low = mid + 1;
            }
        }

        return low;
    }
}